# J.A.R.V.I.S — Environment Variables Template
# Copy this file to .env and fill in your real values
# DO NOT commit your real .env file to Git

# ── Core — only GEMINI_API_KEY is required (the server exits with code 1 without it) ──
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
PORT=3000

# ── Optional service keys ──
# YOUTUBE_API_KEY=        video stats + the youtube_search tool
# SEMANTIC_SCHOLAR_KEY=   higher quota on the research sources
# CORE_API_KEY=           the CORE research source returns nothing without it

# ── /api/ask — streaming (SSE) ──
# ASK_STREAM_DISABLED=1
#     no SSE at all: every answer comes back as a single JSON body
# ASK_STREAM_HEARTBEAT_MS=10000
#     interval of the `: ping` comment frames sent while Gemini is still thinking

# ── /api/ask — function calling (tools) ──
# ASK_TOOLS_DISABLED=1
#     drop the tools entirely: one Gemini call, one text answer
# ASK_TOOLS_MAX_ROUNDS=3
#     tool rounds allowed before the final, tool-free call that forces an answer
# ASK_TOOLS_BUDGET_MS=100000
#     wall-clock budget for the whole tool loop — rounds, tools and retries together
# ASK_TOOL_TIMEOUT_MS=30000
#     ceiling for a single tool execution; web_search launches a real Chrome

# ── /api/ask — answer cache (in-memory LRU) ──
# ASK_CACHE_ENABLED=0
#     turn the cache off
# ASK_CACHE_TTL_MS=300000
# ASK_CACHE_MAX_ENTRIES=100
# ASK_CACHE_MIN_QUERY_LENGTH=8
# ASK_CACHE_ALLOW_HISTORY=1
#     also cache answers that carry conversation history (off by default)

# Every other variable is optional and falls back to a default in the CONFIG block at the top of
# server.js — see the full list in PROJECT_MAP.md §6.
